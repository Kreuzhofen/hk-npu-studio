{
  "package_version": "1.0.0",
  "model_id": "flux_dev",
  "display_name": "Flux.1 Dev",
  "author": "Black Forest Labs",
  "version": "1.0.0",
  "capabilities": {
    "txt2img": true,
    "img2img": true,
    "inpainting": false,
    "outpainting": false,
    "lora": true,
    "controlnet": true,
    "image_to_video": false,
    "batch_generation": true,
    "onnx_runtime": true,
    "qnn_runtime": true
  },
  "components": {
    "tokenizer": {
      "type": "tokenizer",
      "path": "tokenizer",
      "runtime": "CPU"
    },
    "text_encoder": {
      "type": "text_encoder",
      "path": "text_encoder/model.onnx",
      "runtime": "ONNX"
    },
    "text_encoder_2": {
      "type": "text_encoder",
      "path": "text_encoder_2/model.onnx",
      "runtime": "ONNX"
    },
    "unet": {
      "type": "unet",
      "path": "unet/model.onnx",
      "runtime": "QNN"
    },
    "vae_decoder": {
      "type": "vae_decoder",
      "path": "vae_decoder/model.onnx",
      "runtime": "ONNX"
    },
    "scheduler": {
      "type": "scheduler",
      "path": "scheduler",
      "runtime": "CPU"
    }
  }
}
